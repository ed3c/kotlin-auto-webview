CREATE TABLE workspace_subject_projection (
  logical_id TEXT NOT NULL,
  kind TEXT NOT NULL,
  payload_json TEXT NOT NULL,
  updated_at_epoch_ms INTEGER NOT NULL,
  tombstoned INTEGER NOT NULL DEFAULT 0,
  PRIMARY KEY (logical_id, kind)
);

CREATE INDEX workspace_subject_active_idx
ON workspace_subject_projection(tombstoned, updated_at_epoch_ms DESC, logical_id ASC);

CREATE TABLE workspace_edge_projection (
  edge_id TEXT NOT NULL PRIMARY KEY,
  from_logical_id TEXT NOT NULL,
  from_kind TEXT NOT NULL,
  relation TEXT NOT NULL,
  to_logical_id TEXT NOT NULL,
  to_kind TEXT NOT NULL,
  payload_json TEXT NOT NULL,
  updated_at_epoch_ms INTEGER NOT NULL
);

CREATE INDEX workspace_edge_from_idx
ON workspace_edge_projection(from_logical_id, from_kind, relation, edge_id);

CREATE TABLE workspace_outbox_event (
  event_id TEXT NOT NULL PRIMARY KEY,
  canonical_logical_id TEXT NOT NULL,
  canonical_kind TEXT NOT NULL,
  payload_json TEXT NOT NULL,
  state TEXT NOT NULL,
  attempt_count INTEGER NOT NULL DEFAULT 0,
  dedupe_key TEXT NOT NULL UNIQUE,
  next_attempt_at_epoch_ms INTEGER NOT NULL,
  created_at_epoch_ms INTEGER NOT NULL,
  updated_at_epoch_ms INTEGER NOT NULL,
  last_error_code TEXT
);

CREATE INDEX workspace_outbox_dispatch_idx
ON workspace_outbox_event(state, next_attempt_at_epoch_ms, created_at_epoch_ms, event_id);

CREATE TABLE workspace_inbox_change (
  proposal_id TEXT NOT NULL PRIMARY KEY,
  canonical_logical_id TEXT NOT NULL,
  canonical_kind TEXT NOT NULL,
  source_projection_id TEXT NOT NULL,
  payload_json TEXT NOT NULL,
  state TEXT NOT NULL,
  received_at_epoch_ms INTEGER NOT NULL,
  updated_at_epoch_ms INTEGER NOT NULL
);

CREATE INDEX workspace_inbox_state_idx
ON workspace_inbox_change(state, received_at_epoch_ms, proposal_id);

upsertWorkspaceSubject:
INSERT OR REPLACE INTO workspace_subject_projection(
  logical_id,
  kind,
  payload_json,
  updated_at_epoch_ms,
  tombstoned
) VALUES (?, ?, ?, ?, 0);

selectWorkspaceSubjectPayload:
SELECT payload_json
FROM workspace_subject_projection
WHERE logical_id = ? AND kind = ?;

selectActiveWorkspaceSubjectPayloads:
SELECT payload_json
FROM workspace_subject_projection
WHERE tombstoned = 0
ORDER BY updated_at_epoch_ms DESC, logical_id ASC
LIMIT ?;

tombstoneWorkspaceSubject:
UPDATE workspace_subject_projection
SET tombstoned = 1, updated_at_epoch_ms = ?
WHERE logical_id = ? AND kind = ?;

countActiveWorkspaceSubjects:
SELECT COUNT(*)
FROM workspace_subject_projection
WHERE tombstoned = 0;

upsertWorkspaceEdge:
INSERT OR REPLACE INTO workspace_edge_projection(
  edge_id,
  from_logical_id,
  from_kind,
  relation,
  to_logical_id,
  to_kind,
  payload_json,
  updated_at_epoch_ms
) VALUES (?, ?, ?, ?, ?, ?, ?, ?);

selectWorkspaceEdgePayloadsFrom:
SELECT payload_json
FROM workspace_edge_projection
WHERE from_logical_id = ? AND from_kind = ?
ORDER BY relation ASC, edge_id ASC;

enqueueWorkspaceOutbox:
INSERT OR IGNORE INTO workspace_outbox_event(
  event_id,
  canonical_logical_id,
  canonical_kind,
  payload_json,
  state,
  attempt_count,
  dedupe_key,
  next_attempt_at_epoch_ms,
  created_at_epoch_ms,
  updated_at_epoch_ms,
  last_error_code
) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

selectWorkspaceOutboxEventIdByDedupe:
SELECT event_id
FROM workspace_outbox_event
WHERE dedupe_key = ?;

selectWorkspaceOutboxStateAndPayload:
SELECT state, payload_json
FROM workspace_outbox_event
WHERE event_id = ?;

selectDispatchableWorkspaceOutboxPayloads:
SELECT payload_json
FROM workspace_outbox_event
WHERE state IN ('PENDING', 'RETRYABLE_FAILURE')
  AND next_attempt_at_epoch_ms <= ?
ORDER BY next_attempt_at_epoch_ms ASC, created_at_epoch_ms ASC, event_id ASC
LIMIT ?;

updateWorkspaceOutbox:
UPDATE workspace_outbox_event
SET payload_json = ?,
    state = ?,
    attempt_count = ?,
    next_attempt_at_epoch_ms = ?,
    updated_at_epoch_ms = ?,
    last_error_code = ?
WHERE event_id = ?;

countWorkspaceOutbox:
SELECT COUNT(*)
FROM workspace_outbox_event;

insertWorkspaceInboxChange:
INSERT OR IGNORE INTO workspace_inbox_change(
  proposal_id,
  canonical_logical_id,
  canonical_kind,
  source_projection_id,
  payload_json,
  state,
  received_at_epoch_ms,
  updated_at_epoch_ms
) VALUES (?, ?, ?, ?, ?, ?, ?, ?);

selectWorkspaceInboxProposalId:
SELECT proposal_id
FROM workspace_inbox_change
WHERE proposal_id = ?;

selectProposedWorkspaceInboxPayloads:
SELECT payload_json
FROM workspace_inbox_change
WHERE state = 'PROPOSED'
ORDER BY received_at_epoch_ms ASC, proposal_id ASC
LIMIT ?;

updateWorkspaceInboxChange:
UPDATE workspace_inbox_change
SET payload_json = ?, state = ?, updated_at_epoch_ms = ?
WHERE proposal_id = ?;

countWorkspaceInbox:
SELECT COUNT(*)
FROM workspace_inbox_change;
