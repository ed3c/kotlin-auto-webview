CREATE TABLE workspace_subject_projection (
  logical_id TEXT NOT NULL,
  kind TEXT NOT NULL,
  payload_json TEXT NOT NULL,
  updated_at_epoch_ms INTEGER NOT NULL,
  tombstoned INTEGER NOT NULL DEFAULT 0,
  PRIMARY KEY (logical_id, kind)
);

CREATE INDEX workspace_subject_active_idx
ON workspace_subject_projection(tombstoned, updated_at_epoch_ms DESC, logical_id ASC);

CREATE TABLE workspace_edge_projection (
  edge_id TEXT NOT NULL PRIMARY KEY,
  from_logical_id TEXT NOT NULL,
  from_kind TEXT NOT NULL,
  relation TEXT NOT NULL,
  to_logical_id TEXT NOT NULL,
  to_kind TEXT NOT NULL,
  payload_json TEXT NOT NULL,
  updated_at_epoch_ms INTEGER NOT NULL
);

CREATE INDEX workspace_edge_from_idx
ON workspace_edge_projection(from_logical_id, from_kind, relation, edge_id);

CREATE TABLE workspace_outbox_event (
  event_id TEXT NOT NULL PRIMARY KEY,
  canonical_logical_id TEXT NOT NULL,
  canonical_kind TEXT NOT NULL,
  payload_json TEXT NOT NULL,
  state TEXT NOT NULL,
  attempt_count INTEGER NOT NULL DEFAULT 0,
  dedupe_key TEXT NOT NULL UNIQUE,
  next_attempt_at_epoch_ms INTEGER NOT NULL,
  created_at_epoch_ms INTEGER NOT NULL,
  updated_at_epoch_ms INTEGER NOT NULL,
  last_error_code TEXT
);

CREATE INDEX workspace_outbox_dispatch_idx
ON workspace_outbox_event(state, next_attempt_at_epoch_ms, created_at_epoch_ms, event_id);

CREATE TABLE workspace_inbox_change (
  proposal_id TEXT NOT NULL PRIMARY KEY,
  canonical_logical_id TEXT NOT NULL,
  canonical_kind TEXT NOT NULL,
  source_projection_id TEXT NOT NULL,
  payload_json TEXT NOT NULL,
  state TEXT NOT NULL,
  received_at_epoch_ms INTEGER NOT NULL,
  updated_at_epoch_ms INTEGER NOT NULL
);

CREATE INDEX workspace_inbox_state_idx
ON workspace_inbox_change(state, received_at_epoch_ms, proposal_id);

upsertWorkspaceSubject:
INSERT INTO workspace_subject_projection(
  logical_id,
  kind,
  payload_json,
  updated_at_epoch_ms,
  tombstoned
) VALUES (?, ?, ?, ?, 0)
ON CONFLICT(logical_id, kind) DO UPDATE SET
  payload_json = excluded.payload_json,
  updated_at_epoch_ms = excluded.updated_at_epoch_ms,
  tombstoned = 0
WHERE excluded.updated_at_epoch_ms > workspace_subject_projection.updated_at_epoch_ms
   OR (
     excluded.updated_at_epoch_ms = workspace_subject_projection.updated_at_epoch_ms
     AND excluded.payload_json = workspace_subject_projection.payload_json
     AND workspace_subject_projection.tombstoned = 0
   );

selectWorkspaceSubjectRow:
SELECT logical_id, kind, payload_json, updated_at_epoch_ms, tombstoned
FROM workspace_subject_projection
WHERE logical_id = ? AND kind = ?;

selectActiveWorkspaceSubjectRows:
SELECT logical_id, kind, payload_json, updated_at_epoch_ms, tombstoned
FROM workspace_subject_projection
WHERE tombstoned = 0
ORDER BY updated_at_epoch_ms DESC, logical_id ASC
LIMIT ?;

tombstoneWorkspaceSubject:
UPDATE workspace_subject_projection
SET tombstoned = 1,
    updated_at_epoch_ms = :updated_at_epoch_ms
WHERE logical_id = :logical_id
  AND kind = :kind
  AND updated_at_epoch_ms < :updated_at_epoch_ms;

countActiveWorkspaceSubjects:
SELECT COUNT(*)
FROM workspace_subject_projection
WHERE tombstoned = 0;

upsertWorkspaceEdge:
INSERT INTO workspace_edge_projection(
  edge_id,
  from_logical_id,
  from_kind,
  relation,
  to_logical_id,
  to_kind,
  payload_json,
  updated_at_epoch_ms
) VALUES (?, ?, ?, ?, ?, ?, ?, ?)
ON CONFLICT(edge_id) DO UPDATE SET
  payload_json = excluded.payload_json,
  updated_at_epoch_ms = excluded.updated_at_epoch_ms
WHERE excluded.from_logical_id = workspace_edge_projection.from_logical_id
  AND excluded.from_kind = workspace_edge_projection.from_kind
  AND excluded.relation = workspace_edge_projection.relation
  AND excluded.to_logical_id = workspace_edge_projection.to_logical_id
  AND excluded.to_kind = workspace_edge_projection.to_kind
  AND (
    excluded.updated_at_epoch_ms > workspace_edge_projection.updated_at_epoch_ms
    OR (
      excluded.updated_at_epoch_ms = workspace_edge_projection.updated_at_epoch_ms
      AND excluded.payload_json = workspace_edge_projection.payload_json
    )
  );

selectWorkspaceEdgeRow:
SELECT
  edge_id,
  from_logical_id,
  from_kind,
  relation,
  to_logical_id,
  to_kind,
  payload_json,
  updated_at_epoch_ms
FROM workspace_edge_projection
WHERE edge_id = ?;

selectWorkspaceEdgeRowsFrom:
SELECT
  edge_id,
  from_logical_id,
  from_kind,
  relation,
  to_logical_id,
  to_kind,
  payload_json,
  updated_at_epoch_ms
FROM workspace_edge_projection
WHERE from_logical_id = ? AND from_kind = ?
ORDER BY relation ASC, edge_id ASC;

enqueueWorkspaceOutbox:
INSERT OR IGNORE INTO workspace_outbox_event(
  event_id,
  canonical_logical_id,
  canonical_kind,
  payload_json,
  state,
  attempt_count,
  dedupe_key,
  next_attempt_at_epoch_ms,
  created_at_epoch_ms,
  updated_at_epoch_ms,
  last_error_code
) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

selectWorkspaceOutboxEventIdByDedupe:
SELECT event_id
FROM workspace_outbox_event
WHERE dedupe_key = ?;

selectWorkspaceOutboxStateAndPayload:
SELECT
  event_id,
  canonical_logical_id,
  canonical_kind,
  state,
  attempt_count,
  payload_json
FROM workspace_outbox_event
WHERE event_id = ?;

selectDispatchableWorkspaceOutboxPayloads:
SELECT
  event_id,
  canonical_logical_id,
  canonical_kind,
  state,
  attempt_count,
  payload_json
FROM workspace_outbox_event
WHERE state IN ('PENDING', 'RETRYABLE_FAILURE')
  AND next_attempt_at_epoch_ms <= ?
ORDER BY next_attempt_at_epoch_ms ASC, created_at_epoch_ms ASC, event_id ASC
LIMIT ?;

updateWorkspaceOutbox:
UPDATE workspace_outbox_event
SET payload_json = ?,
    state = ?,
    attempt_count = ?,
    next_attempt_at_epoch_ms = ?,
    updated_at_epoch_ms = ?,
    last_error_code = ?
WHERE event_id = ?;

countWorkspaceOutbox:
SELECT COUNT(*)
FROM workspace_outbox_event;

insertWorkspaceInboxChange:
INSERT OR IGNORE INTO workspace_inbox_change(
  proposal_id,
  canonical_logical_id,
  canonical_kind,
  source_projection_id,
  payload_json,
  state,
  received_at_epoch_ms,
  updated_at_epoch_ms
) VALUES (?, ?, ?, ?, ?, ?, ?, ?);

selectWorkspaceInboxProposalId:
SELECT proposal_id
FROM workspace_inbox_change
WHERE proposal_id = ?;

selectWorkspaceInboxStateAndPayload:
SELECT
  proposal_id,
  canonical_logical_id,
  canonical_kind,
  source_projection_id,
  state,
  payload_json
FROM workspace_inbox_change
WHERE proposal_id = ?;

selectProposedWorkspaceInboxPayloads:
SELECT
  proposal_id,
  canonical_logical_id,
  canonical_kind,
  source_projection_id,
  state,
  payload_json
FROM workspace_inbox_change
WHERE state = 'PROPOSED'
ORDER BY received_at_epoch_ms ASC, proposal_id ASC
LIMIT ?;

updateWorkspaceInboxChange:
UPDATE workspace_inbox_change
SET payload_json = ?, state = ?, updated_at_epoch_ms = ?
WHERE proposal_id = ?;

countWorkspaceInbox:
SELECT COUNT(*)
FROM workspace_inbox_change;
