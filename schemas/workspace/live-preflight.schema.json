{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ed3c/kotlin-auto-webview/schemas/workspace/live-preflight.schema.json",
  "title": "Federated Capability Workspace Live Evidence Preflight",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "program",
    "owner_issue",
    "parent_epic",
    "foundation",
    "atoms",
    "required_lanes",
    "local_handoff",
    "hard_laws",
    "void_issues_excluded"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "program": {"const": "FEDERATED_CAPABILITY_WORKSPACE_LIVE_EVIDENCE"},
    "owner_issue": {"const": 172},
    "parent_epic": {"const": 164},
    "foundation": {
      "type": "array",
      "minItems": 7,
      "maxItems": 7,
      "items": {"$ref": "#/$defs/foundation"}
    },
    "atoms": {
      "type": "array",
      "minItems": 8,
      "maxItems": 8,
      "items": {"$ref": "#/$defs/atom"}
    },
    "required_lanes": {
      "type": "object",
      "additionalProperties": false,
      "required": ["L2", "L3", "L4", "L5", "L6", "L7"],
      "properties": {
        "L2": {"const": "NOT_EXERCISED"},
        "L3": {"const": "NOT_EXERCISED"},
        "L4": {"const": "NOT_EXERCISED"},
        "L5": {"const": "NOT_EXERCISED"},
        "L6": {"const": "NOT_EXERCISED"},
        "L7": {"const": "ABSENT"}
      }
    },
    "local_handoff": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state", "reason"],
      "properties": {
        "state": {"const": "ABSENT"},
        "reason": {"const": "EXTERNAL_CAPABILITIES_AND_CONCRETE_COMMANDS_NOT_YET_BOUND"}
      }
    },
    "hard_laws": {
      "type": "object",
      "additionalProperties": {"const": false},
      "minProperties": 7
    },
    "void_issues_excluded": {
      "type": "array",
      "const": [173, 174]
    }
  },
  "$defs": {
    "sha": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "foundation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["atom", "issue", "pr", "head_sha", "workflow_run_ids", "state"],
      "properties": {
        "atom": {"pattern": "^W[0-6]$"},
        "issue": {"type": "integer"},
        "pr": {"type": "integer"},
        "head_sha": {"$ref": "#/$defs/sha"},
        "workflow_run_ids": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "integer", "minimum": 1}
        },
        "state": {"const": "CLOSED_DETERMINISTIC"}
      }
    },
    "git_parent": {
      "type": ["object", "null"],
      "properties": {
        "pr": {"type": "integer"},
        "head_sha": {"$ref": "#/$defs/sha"}
      },
      "required": ["pr", "head_sha"],
      "additionalProperties": false
    },
    "atom": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "atom",
        "issue",
        "lane",
        "state",
        "git_parent",
        "planned_branch",
        "planned_paths",
        "start_dependencies",
        "completion_dependencies",
        "evidence_dependencies",
        "external_authorities",
        "maximum_claim"
      ],
      "properties": {
        "atom": {"type": "string"},
        "issue": {"type": "integer"},
        "lane": {"type": "string"},
        "state": {"type": "string"},
        "git_parent": {"$ref": "#/$defs/git_parent"},
        "planned_branch": {"type": "string", "minLength": 1},
        "planned_paths": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "start_dependencies": {"type": "array", "items": {"type": "integer"}},
        "completion_dependencies": {"type": "array", "items": {"type": "integer"}},
        "evidence_dependencies": {"type": "array", "items": {"type": "integer"}},
        "external_issues": {"type": "array", "items": {"type": "string"}},
        "external_authorities": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string"}
        },
        "maximum_claim": {"type": "string", "minLength": 1}
      }
    }
  }
}
